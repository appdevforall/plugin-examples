<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Makes live HTTPS calls to the Gemini REST API (GeminiBackend, raw HttpURLConnection) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="AI Gemini Backend Plugin"
        android:theme="@style/PluginTheme">

        <!-- Plugin metadata -->
        <meta-data
            android:name="plugin.id"
            android:value="com.itsaky.androidide.plugins.aigemini" />

        <meta-data
            android:name="plugin.name"
            android:value="AI Gemini Backend" />

        <meta-data
            android:name="plugin.version"
            android:value="${pluginVersion}" />

        <meta-data
            android:name="plugin.description"
            android:value="Google Gemini API inference backend for AI Core. Requires a Gemini API key, entered in AI Assistant's AI Settings." />

        <meta-data
            android:name="plugin.author"
            android:value="App Dev for All" />

        <meta-data
            android:name="plugin.min_ide_version"
            android:value="26.17" />

        <meta-data
            android:name="plugin.max_ide_version"
            android:value="26.99" />

        <!-- network.access: HTTPS calls to generativelanguage.googleapis.com. No filesystem
             or native code — the API key lives in ai-assistant's SharedPreferences. -->
        <meta-data
            android:name="plugin.permissions"
            android:value="network.access" />

        <meta-data
            android:name="plugin.main_class"
            android:value="com.itsaky.androidide.plugins.aigemini.GeminiPlugin" />

        <meta-data
            android:name="plugin.icon_day"
            android:value="assets/icon_day.png" />

        <meta-data
            android:name="plugin.icon_night"
            android:value="assets/icon_night.png" />

    </application>

</manifest>
