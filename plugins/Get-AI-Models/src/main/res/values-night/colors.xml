    <!--
        Night mirror of the progress palette. The gradient end is capped at #007658 rather than a
        brighter teal so the label keeps >= 4.5:1 across the whole fill, not only at the dark end
        (label/fill-start 8.3:1, label/fill-end 4.8:1, label/track 14.6:1).
    -->
    <color name="progress_track">#20241F</color>
    <color name="progress_track_outline">#5A645D</color>
    <color name="progress_fill_start">#004E3B</color>
    <color name="progress_fill_end">#007658</color>
    <color name="progress_label">#C6F7E2</color>

    <!--
        No verify_button_* overrides on purpose - that button is a fixed white-on-blue pair defined
        only in values/colors.xml precisely so it cannot pick up one mode's text with the other
        mode's background. Do not add night variants for it.
    -->
</resources>
