<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

<application
    android:label="@string/app_name"
    android:theme="@style/PluginTheme">

    <meta-data
        android:name="plugin.id"
        android:value="org.appdevforall.templatemanagerplugin" />

    <meta-data
        android:name="plugin.name"
        android:value="Template Manager" />

    <meta-data
        android:name="plugin.version"
        android:value="${pluginVersion}" />

    <meta-data
        android:name="plugin.description"
        android:value="Browse, install, uninstall, and delete Code On The Go project templates (.cgt files) from your Downloads folder." />

    <meta-data
        android:name="plugin.author"
        android:value="App Dev For All" />

    <meta-data
        android:name="plugin.min_ide_version"
        android:value="26.29" />

    <meta-data
        android:name="plugin.max_ide_version"
        android:value="26.30" />

    <!--
        Declare ONLY the permissions the plugin actually exercises — request the least
        privilege the feature needs (see PluginPermission in plugin-api.jar for the full set):
          - filesystem.read      : Read files from the filesystem
          - filesystem.write     : Write files to the filesystem
          - network.access       : Access the network
          - system.commands      : Execute system commands
          - ide.settings         : Read/modify IDE settings
          - ide.environment.write: Modify the IDE environment (SDK/NDK/tmp/plugin dirs)
          - project.structure    : Access the open project's structure
          - native.code          : Ship/execute bundled native (.so) libraries

        This plugin requests exactly two, both used on live code paths:
          - filesystem.read  : list and parse .cgt files in Downloads and the template store
          - filesystem.write : register/unregister templates and move/delete .cgt files
        No network, system-command, IDE-settings, or native-code access is requested.
    -->
    <meta-data
        android:name="plugin.permissions"
        android:value="filesystem.read,filesystem.write" />

    <meta-data
        android:name="plugin.icon_day"
        android:value="assets/icon_day.png" />

    <meta-data
        android:name="plugin.icon_night"
        android:value="assets/icon_night.png" />

    <meta-data
        android:name="plugin.main_class"
        android:value="org.appdevforall.templatemanagerplugin.TemplateManagerPlugin" />

    <meta-data
        android:name="plugin.sidebar_items"
        android:value="1" />

    <meta-data
        android:name="plugin.editor_tabs"
        android:value="1" />

</application>

</manifest>
